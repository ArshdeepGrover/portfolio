{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.arshdeepgrover.dev"
        }
      ],
      "destination": "https://arshdeepgrover.dev/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
