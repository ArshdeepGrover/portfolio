{
  "name": "arshdeep-workspace",
  "version": "0.0.0",
  "scripts": {
    "start:portfolio": "ng serve portfolio --port 4200",
    "start:studio": "ng serve studio    --port 4300",
    "start:links": "ng serve links     --port 4400",
    "start:blogs": "ng serve blogs     --port 4500",
    "start:sanity": "cd projects/blogs-studio && npm run dev",
    "start:all": "concurrently \"npm run start:portfolio\" \"npm run start:studio\" \"npm run start:links\" \"npm run start:blogs\"",
    "build:portfolio": "ng build portfolio  --configuration production",
    "build:studio": "ng build studio     --configuration production",
    "build:links": "ng build links      --configuration production",
    "build:blogs": "ng build blogs      --configuration production",
    "build:all": "ng build portfolio && ng build studio && ng build links && ng build blogs",
    "watch:portfolio": "ng build portfolio --watch --configuration development",
    "watch:studio": "ng build studio    --watch --configuration development",
    "watch:links": "ng build links     --watch --configuration development",
    "watch:blogs": "ng build blogs     --watch --configuration development",
    "test:portfolio": "ng test portfolio --watch=false",
    "test:studio": "ng test studio    --watch=false",
    "test:links": "ng test links     --watch=false",
    "test:blogs": "ng test blogs     --watch=false",
    "lint": "ng lint",
    "sanity:patch": "node scripts/patch-sanity-data.js",
    "sanity:import": "node scripts/import-blogs.js",
    "sanity:draft-all": "node scripts/patch-all-draft.js",
    "sanity:publish-all": "node scripts/patch-all-draft.js --publish",
    "ng": "ng"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@google/genai": "^1.48.0",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@types/marked": "^5.0.2",
    "marked": "^17.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typed.js": "^2.1.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@sanity/client": "^7.22.1",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.27",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.5.2"
  }
}